{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/graph-hook.sh\" update",
            "timeout": 30,
            "statusMessage": "Updating code-review-graph"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/graph-hook.sh\" status",
            "timeout": 10,
            "statusMessage": "Checking code-review-graph status"
          }
        ]
      }
    ]
  }
}
